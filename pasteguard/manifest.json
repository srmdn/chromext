{
  "manifest_version": 3,
  "name": "PasteGuard",
  "version": "1.0.0",
  "description": "Stop pasting API keys and secrets into AI chats. Warns, masks, or blocks before you leak credentials.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://chat.openai.com/*",
    "*://claude.ai/*",
    "*://gemini.google.com/*",
    "*://gemini.google.com/*",
    "*://copilot.microsoft.com/*",
    "*://github.com/copilot/*",
    "*://bard.google.com/*",
    "*://deepseek.com/*",
    "*://chat.deepseek.com/*",
    "*://perplexity.ai/*",
    "*://poe.com/*",
    "*://you.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://claude.ai/*",
        "*://gemini.google.com/*",
        "*://copilot.microsoft.com/*",
        "*://github.com/copilot/*",
        "*://bard.google.com/*",
        "*://chat.deepseek.com/*",
        "*://deepseek.com/*",
        "*://perplexity.ai/*",
        "*://poe.com/*",
        "*://you.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": ["<all_urls>"],
      "resources": ["icons/shield.svg"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PasteGuard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
